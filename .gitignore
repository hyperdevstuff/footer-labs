# deps
node_modules
.pnpm-store

# next
.next
out
next-env.d.ts

# build
dist
*.tsbuildinfo

# generated from packages/registry metadata by scripts/build-registry.ts
# `pnpm registry:build` recreates these; the registry's `pretypecheck` script
# guarantees they exist before anything typechecks, so they are not committed.
packages/registry/src/generated/
apps/site/public/r/

# env
.env
.env*.local

# biome
.cache

# playwright (browser testing runs in CI, never locally)
test-results
playwright-report
.playwright

# regards-art-direction skill working files (specimen sheet, inspector output).
# The skill's own scripts already skip this folder; git needs telling.
.taste-skill/

# os
.DS_Store
Thumbs.db
.commandcode

# Local agent tooling. These are third-party skill directories that write
# reports and caches into the repo. Biome and ESLint both walk them, so they
# are ignored at the source rather than excluded per-tool in each config.
.taste-skill/
