{
  "name": "footer-labs",
  "version": "0.1.0",
  "private": true,
  "description": "Tasteful footers, because we care about the end.",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm registry:build && pnpm --filter @footer-labs/site dev",
    "build": "pnpm registry:build && pnpm --filter @footer-labs/site build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "pnpm -r --if-present typecheck",
    "registry:build": "pnpm --filter @footer-labs/registry build",
    "registry:validate": "pnpm --filter @footer-labs/registry validate"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@shadcn/lint": "0.2.1",
    "@types/node": "^22.10.0",
    "@biomejs/biome": "^2.4.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0"
  }
}
